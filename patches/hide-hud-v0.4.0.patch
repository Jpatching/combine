+#[test]
+fn practice_hide_hud_keyboard_round_trip_and_input_isolation() {
+    let mut a = app();
+    assert!(!a.world().resource::<frame::GameplayHud>().hidden);
+    open(&mut a);
+    tap(&mut a, KeyCode::ArrowUp); // Wrap to Appearance through the actual menu.
+    tap(&mut a, KeyCode::Enter);
+    assert_eq!(a.world().resource::<Practice>().menu.page, Page::Appearance);
+    key(&mut a, KeyCode::Enter, true);
+    assert!(a.world().resource::<frame::GameplayHud>().hidden);
+    key(&mut a, KeyCode::KeyJ, true);
+    key(&mut a, KeyCode::Space, true);
+    a.world_mut().resource_mut::<ButtonInput<MouseButton>>().press(MouseButton::Left);
+    for _ in 0..3 {
+        a.update();
+        assert!(a.world().resource::<frame::GameplayHud>().hidden); // No held repeat.
+        assert!(!a.world().resource::<frame::SkateMode>().toggle_requested);
+        assert!(a.world().resource::<net::ClientActionInput>().client.keys.iter().all(|k| k.down == 0));
+    }
+    tap(&mut a, KeyCode::Escape);
+    assert!(!a.world().resource::<Practice>().menu.open);
+    assert!(a.world().resource::<Practice>().captured);
+    for k in [KeyCode::Enter, KeyCode::KeyJ, KeyCode::Space] { key(&mut a, k, false); }
+    a.world_mut().resource_mut::<ButtonInput<MouseButton>>().release(MouseButton::Left);
+    a.update(); a.update();
+    assert!(!a.world().resource::<Practice>().captured);
+    open(&mut a);
+    assert_eq!(a.world().resource::<Practice>().menu.page, Page::Appearance);
+    tap(&mut a, KeyCode::Enter);
+    assert!(!a.world().resource::<frame::GameplayHud>().hidden);
+    assert_eq!(a.world().resource::<Practice>().status, "HUD visible.");
+}
