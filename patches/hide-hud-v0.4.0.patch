+#[test]
+fn practice_hide_hud_skating_banner_preserves_actionable_prompts() {
+    use crate::skate_overlay::{SkateHud, update_skate_overlay};
+    let mut a = app();
+    a.world_mut().resource_mut::<frame::GameplayHud>().hidden = true;
+    let banner = a.world_mut().spawn((SkateHud, Text::default(), Visibility::Visible)).id();
+    {
+        let mut mode = a.world_mut().resource_mut::<frame::SkateMode>();
+        mode.active = true; mode.preloaded = true; mode.controller = Some(0);
+    }
+    a.world_mut().run_system_once(update_skate_overlay).unwrap();
+    assert_eq!(*a.world().get::<Visibility>(banner).unwrap(), Visibility::Hidden);
+    a.world_mut().resource_mut::<frame::SkateMode>().controller = None;
+    a.world_mut().run_system_once(update_skate_overlay).unwrap();
+    assert_eq!(*a.world().get::<Visibility>(banner).unwrap(), Visibility::Visible);
+    assert!(a.world().get::<Text>(banner).unwrap().contains("Connect a controller"));
+    {
+        let mut mode = a.world_mut().resource_mut::<frame::SkateMode>();
+        mode.active = false; mode.preloaded = false; mode.entering = true; mode.preload_pending = true;
+    }
+    a.world_mut().run_system_once(update_skate_overlay).unwrap();
+    assert_eq!(*a.world().get::<Visibility>(banner).unwrap(), Visibility::Visible);
+    assert!(a.world().get::<Text>(banner).unwrap().contains("J: cancel"));
+    {
+        let mut mode = a.world_mut().resource_mut::<frame::SkateMode>();
+        mode.entering = false; mode.preload_pending = false; mode.status = "Synthetic missing assets".into();
+    }
+    a.world_mut().run_system_once(update_skate_overlay).unwrap();
+    assert_eq!(*a.world().get::<Visibility>(banner).unwrap(), Visibility::Visible);
+    assert!(a.world().get::<Text>(banner).unwrap().contains("Skate unavailable"));
+    {
+        let mut mode = a.world_mut().resource_mut::<frame::SkateMode>();
+        mode.preloaded = true; mode.active = true; mode.controller = Some(0); mode.status.clear();
+    }
+    a.world_mut().resource_mut::<frame::GameplayHud>().hidden = false;
+    a.world_mut().run_system_once(update_skate_overlay).unwrap();
+    assert_eq!(*a.world().get::<Visibility>(banner).unwrap(), Visibility::Visible);
+}
