+#[test]
+fn practice_hide_hud_pad_navigation_and_hold_isolation() {
+    let mut a = app();
+    let pad = a.world_mut().spawn(Gamepad::default()).id();
+    a.world_mut().resource_mut::<frame::ActivePad>().0 = Some(pad);
+    fn buttons(a: &mut App, pad: Entity, buttons: &[B]) {
+        let mut p = a.world_mut().get_mut::<Gamepad>(pad).unwrap();
+        p.digital_mut().reset_all();
+        for &b in buttons { p.digital_mut().press(b); }
+        drop(p);
+        a.world_mut().run_system_once(input).unwrap();
+    }
+    for bs in [&[B::LeftTrigger2, B::RightThumb][..], &[], &[B::DPadUp], &[], &[B::South], &[], &[B::West]] {
+        buttons(&mut a, pad, bs);
+    }
+    assert_eq!(a.world().resource::<Practice>().menu.page, Page::Appearance);
+    assert!(a.world().resource::<frame::GameplayHud>().hidden);
+    for _ in 0..3 { a.update(); }
+    assert!(a.world().resource::<frame::GameplayHud>().hidden);
+    buttons(&mut a, pad, &[]);
+    buttons(&mut a, pad, &[B::LeftTrigger2, B::RightThumb, B::RightTrigger2, B::South, B::LeftThumb]);
+    a.update();
+    assert!(!a.world().resource::<Practice>().menu.open);
+    assert!(a.world().resource::<Practice>().captured);
+    assert!(!a.world().resource::<frame::SkateMode>().toggle_requested);
+    assert!(a.world().resource::<net::ClientActionInput>().client.keys.iter().all(|k| k.down == 0));
+    buttons(&mut a, pad, &[]); a.update();
+    buttons(&mut a, pad, &[B::LeftTrigger2, B::RightThumb]);
+    buttons(&mut a, pad, &[]);
+    buttons(&mut a, pad, &[B::South]);
+    assert!(!a.world().resource::<frame::GameplayHud>().hidden);
+}
