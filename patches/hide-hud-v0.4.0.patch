new file mode 100644
--- /dev/null
+++ b/crates/hud/src/gameplay_visibility.rs
@@ -0,0 +1,24 @@
+//! Gameplay geometry is emitted before recovery/menu surfaces.
+use bevy::prelude::*;
+use frame::{AppScreen, GameplayHud};
+use crate::HudTessGpuFrame;
+
+#[derive(Component)]
+pub struct GameplayHudRoot;
+
+/// Run after gameplay HUD tessellation and before inventory/script-menu tessellation.
+/// Keep cached geometry intact so turning the HUD back on restores static surfaces.
+pub fn suppress_gameplay_hud(
+    setting: Res<GameplayHud>,
+    screen: Res<AppScreen>,
+    mut geometry: ResMut<HudTessGpuFrame>,
+    mut roots: Query<&mut Node, With<GameplayHudRoot>>,
+) {
+    let hidden = setting.hidden_in(*screen);
+    if hidden {
+        geometry.clear_geometry();
+    }
+    for mut node in &mut roots {
+        node.display = if hidden { Display::None } else { Display::Flex };
+    }
+}
