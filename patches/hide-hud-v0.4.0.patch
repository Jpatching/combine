new file mode 100644
--- /dev/null
+++ b/crates/console/src/skate_overlay.rs
@@ -0,0 +1,24 @@
+use bevy::prelude::*;
+
+#[derive(Component)]
+pub(crate) struct SkateHud;
+
+pub(crate) fn update_skate_overlay(
+    mode: Res<frame::SkateMode>,
+    setting: Res<frame::GameplayHud>,
+    screen: Res<frame::AppScreen>,
+    mut hud: Query<(&mut Text, &mut Visibility), With<SkateHud>>,
+) {
+    let failed = !mode.preloaded && !mode.preload_pending && !mode.status.is_empty();
+    let preparing = mode.entering && !mode.preloaded;
+    let needs_controller = (mode.active || mode.entering) && mode.controller.is_none();
+    let visible = failed || preparing || needs_controller
+        || ((mode.active || mode.entering) && !setting.hidden_in(*screen));
+    for (mut text, mut visibility) in &mut hud {
+        *visibility = if visible { Visibility::Visible } else { Visibility::Hidden };
+        **text = if failed { format!("Skate unavailable: {}", mode.status) }
+        else if preparing { "Skate is finishing map preparation... | J: cancel".into() }
+        else if needs_controller { "SKATE | Connect a controller | J: return to MW2".into() }
+        else { "SKATE | Original controller controls | Start: pause | J: return to MW2".into() };
+    }
+}
