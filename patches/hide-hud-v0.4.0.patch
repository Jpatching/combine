+    a.world_mut().resource_mut::<hud::HudTessGpuFrame>().indices = vec![0, 1, 2];
+    a.world_mut().run_system_once(suppress_gameplay_hud).unwrap();
+    assert!(a.world().resource::<hud::HudTessGpuFrame>().indices.is_empty());
+    assert_eq!(a.world().get::<Node>(native).unwrap().display, Display::None);
+    assert_eq!(a.world().get::<Node>(recovery).unwrap().display, Display::Flex);
+    a.world_mut().run_system_once(publish_view).unwrap();
+    assert!(a.world().resource::<MenuView>().hide_hud);
+    a.world_mut().run_system_once(crate::practice_ui::render).unwrap();
+    assert_eq!(a.world_mut().query_filtered::<Entity, With<crate::practice_ui::MenuRoot>>().iter(a.world()).count(), 1);
+    tap(&mut a, KeyCode::Enter);
+    a.world_mut().resource_mut::<hud::HudTessGpuFrame>().indices = vec![0, 1, 2];
+    a.world_mut().run_system_once(suppress_gameplay_hud).unwrap();
+    assert_eq!(a.world().resource::<hud::HudTessGpuFrame>().indices, vec![0, 1, 2]);
+    assert_eq!(a.world().get::<Node>(native).unwrap().display, Display::Flex);
+}
