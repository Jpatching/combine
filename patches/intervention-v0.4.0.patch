+fn practice_unavailable_context_keeps_menu_open_and_allows_retry() {
+    for failure in ["world", "catalogue", "unknown", "dead", "queue", "guest"] {
+        let mut a = ready();
+        navigate(&mut a);
+        let mut snapshot = a
+            .world()
+            .resource::<PresentedSnapshot>()
+            .snapshot()
+            .unwrap()
+            .clone();
+        match failure {
+            "world" => {
+                a.world_mut().remove_resource::<AuthorityWorld>();
+            }
+            "catalogue" => {
+                a.world_mut().remove_resource::<assets::PreparedWeapons>();
+            }
+            "unknown" => {
+                a.insert_resource(assets::PreparedWeapons(std::sync::Arc::new(
+                    asset_game::WeaponRegistry::default(),
+                )));
+            }
+            "dead" => {
+                snapshot.meta.clients[0].1.lifecycle = sim::ClientLifecycle::Dead;
+                a.world_mut()
+                    .resource_mut::<PresentedSnapshot>()
+                    .publish_decoded(snapshot);
+            }
+            "queue" => {
+                a.world_mut().remove_resource::<ClientActionInbox>();
+            }
+            "guest" => {
+                a.insert_resource(RuntimeRole::Client);
+            }
+            _ => unreachable!(),
+        }
+        tap(&mut a, KeyCode::Enter);
+        let state = a.world().resource::<Practice>();
+        assert!(state.menu.open && state.pending.is_none(), "{failure}");
+        assert!(
+            !state.status.contains("equipped") && !state.status.contains("requested"),
+            "{failure}: {}",
+            state.status
+        );
+        // Restore the real resources, retaining navigation and the error feedback.
+        let mut fresh = ready();
+        a.insert_resource(
+            fresh
+                .world_mut()
+                .remove_resource::<AuthorityWorld>()
+                .unwrap(),
+        );
+        a.insert_resource(
+            fresh
+                .world_mut()
+                .remove_resource::<PresentedSnapshot>()
+                .unwrap(),
+        );
+        a.insert_resource(catalogue())
+            .insert_resource(RuntimeRole::Listen)
+            .init_resource::<ClientActionInbox>();
+        tap(&mut a, KeyCode::Enter);
+        simulate(&mut a);
+        assert!(
+            a.world().resource::<Practice>().status.contains("equipped"),
+            "retry {failure}: {}",
+            a.world().resource::<Practice>().status
+        );
+    }
