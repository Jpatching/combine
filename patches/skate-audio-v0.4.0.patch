diff --git a/crates/audio/src/skate.rs b/crates/audio/src/skate.rs
new file mode 100644
--- /dev/null
+++ b/crates/audio/src/skate.rs
@@ -0,0 +1,276 @@
+//! Optional local Skate samples. No audio assets or music ship with the patch.
+use crate::PcmAudio;
+use bevy::{
+    audio::{AudioSink, AudioSinkPlayback, PlaybackSettings, Volume},
+    prelude::*,
+};
+use std::path::Path;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum SkateSound {
+    Pop,
+    Land,
+    ChristAir,
+}
+#[derive(Resource, Default)]
+pub struct SkateSoundQueue(pub Vec<(SkateSound, f32)>);
+#[derive(Resource, Default)]
+struct MusicEntry(bool);
+
+#[derive(Clone)]
+struct Clip {
+    handle: Handle<PcmAudio>,
+    seconds: f32,
+}
+#[derive(Resource, Default)]
+struct Clips {
+    pop: Option<Clip>,
+    land: Option<Clip>,
+    music: Option<Clip>,
+}
+#[derive(Component)]
+struct Voice {
+    music: bool,
+    remaining: f32,
+    gain: f32,
+}
+
+pub(crate) fn register(app: &mut App) {
+    app.init_resource::<SkateSoundQueue>()
+        .init_resource::<MusicEntry>()
+        .init_resource::<Clips>()
+        .add_systems(Startup, preload)
+        .add_systems(PostUpdate, play);
+}
+
+fn read_clip(path: &Path, assets: &mut Assets<PcmAudio>, max_seconds: f32) -> Result<Clip, String> {
+    let size = std::fs::metadata(path).map_err(|e| e.to_string())?.len();
+    if size > 16 * 1024 * 1024 {
+        return Err("WAV exceeds 16 MiB".into());
+    }
+    let bytes = std::fs::read(path).map_err(|e| e.to_string())?;
+    if bytes.get(..4) != Some(b"RIFF") || bytes.get(8..12) != Some(b"WAVE") {
+        return Err("expected a local WAV file".into());
+    }
+    let pcm = crate::decode_audio_bytes(&bytes).ok_or("WAV did not decode")?;
+    let seconds = pcm.samples().len() as f32 / pcm.channel_count() as f32 / pcm.rate() as f32;
+    if !seconds.is_finite() || seconds <= 0.0 || seconds > max_seconds {
+        return Err(format!("WAV must be between 0 and {max_seconds} seconds"));
+    }
+    Ok(Clip {
+        handle: assets.add(pcm),
+        seconds,
+    })
+}
+
+fn preload(mut clips: ResMut<Clips>, mut assets: ResMut<Assets<PcmAudio>>) {
+    let root = std::env::var_os("IW4L_SKATE_AUDIO")
+        .map(std::path::PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("IW4L_SKATE_ASSETS")
+                .map(|p| std::path::PathBuf::from(p).join("private/audio"))
+        });
+    let Some(root) = root else { return };
+    let mut load =
+        |name: &str, seconds: f32| match read_clip(&root.join(name), &mut assets, seconds) {
+            Ok(clip) => Some(clip),
+            Err(error) => {
+                diag::warn!(Audio, "Skate audio {name} unavailable: {error}");
+                None
+            }
+        };
+    clips.pop = load("pop.wav", 5.0);
+    clips.land = load("land.wav", 5.0);
+    clips.music = load("christ-air.wav", 20.0);
+    diag::info!(
+        Audio,
+        "Skate audio ready: pop={} land={} Christ Air music={}",
+        clips.pop.is_some(),
+        clips.land.is_some(),
+        clips.music.is_some()
+    );
+}
+
+fn play(
+    mut commands: Commands,
+    time: Res<Time>,
+    mode: Option<Res<frame::SkateMode>>,
+    screen: Option<Res<frame::AppScreen>>,
+    settings: Option<Res<frame::GameSettings>>,
+    mut queue: ResMut<SkateSoundQueue>,
+    mut entry: ResMut<MusicEntry>,
+    clips: Res<Clips>,
+    mut voices: Query<(
+        Entity,
+        &mut Voice,
+        &mut PlaybackSettings,
+        Option<&mut AudioSink>,
+    )>,
+) {
+    let riding = mode.as_ref().is_some_and(|m| m.active);
+    let just_entered = riding && !entry.0;
+    entry.0 = riding;
+    let enabled = mode.is_some_and(|m| m.active && !m.input_blocked)
+        && screen.is_some_and(|s| *s == frame::AppScreen::InGame);
+    let mut music_busy = false;
+    for (entity, mut voice, mut playback, sink) in &mut voices {
+        voice.remaining -= time.delta_secs();
+        if !enabled || voice.remaining <= 0.0 || sink.as_ref().is_some_and(|s| s.empty()) {
+            commands.entity(entity).try_despawn();
+            continue;
+        }
+        if voice.music {
+            music_busy = true;
+            let gain = voice.gain * (voice.remaining / 0.4).clamp(0.0, 1.0);
+            playback.volume = Volume::Linear(gain);
+            if let Some(mut sink) = sink {
+                sink.set_volume(Volume::Linear(
+                    gain * settings.as_ref().map_or(1.0, |s| s.master_volume),
+                ));
+            }
+        }
+    }
+    if just_entered && enabled {
+        queue.0.push((SkateSound::ChristAir, 0.32));
+    }
+    for (kind, gain) in std::mem::take(&mut queue.0).into_iter().take(32) {
+        if !enabled || !gain.is_finite() || gain <= 0.0 {
+            continue;
+        }
+        let music = kind == SkateSound::ChristAir;
+        if music && music_busy {
+            continue;
+        }
+        let clip = match kind {
+            SkateSound::Pop => &clips.pop,
+            SkateSound::Land => &clips.land,
+            SkateSound::ChristAir => &clips.music,
+        };
+        let Some(clip) = clip else { continue };
+        let gain = gain.clamp(0.0, 1.0);
+        commands.spawn((
+            AudioPlayer(clip.handle.clone()),
+            PlaybackSettings::DESPAWN.with_volume(Volume::Linear(gain)),
+            Voice {
+                music,
+                remaining: clip.seconds.min(if music { 10.0 } else { 5.0 }),
+                gain,
+            },
+        ));
+        music_busy |= music;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn app() -> App {
+        let mut app = App::new();
+        app.init_resource::<Time>()
+            .init_resource::<SkateSoundQueue>()
+            .init_resource::<MusicEntry>()
+            .insert_resource(frame::SkateMode {
+                active: true,
+                ..Default::default()
+            })
+            .insert_resource(frame::AppScreen::InGame)
+            .insert_resource(Clips {
+                pop: Some(Clip {
+                    handle: Handle::default(),
+                    seconds: 0.3,
+                }),
+                land: Some(Clip {
+                    handle: Handle::default(),
+                    seconds: 0.5,
+                }),
+                music: Some(Clip {
+                    handle: Handle::default(),
+                    seconds: 10.0,
+                }),
+            })
+            .add_systems(Update, play);
+        app
+    }
+    fn send(app: &mut App, sound: SkateSound) {
+        app.world_mut()
+            .resource_mut::<SkateSoundQueue>()
+            .0
+            .push((sound, 0.8));
+    }
+    fn count(app: &mut App) -> usize {
+        app.world_mut().query::<&Voice>().iter(app.world()).count()
+    }
+    #[test]
+    fn cues_spawn_once_and_music_does_not_overlap() {
+        let mut a = app();
+        send(&mut a, SkateSound::Pop);
+        send(&mut a, SkateSound::ChristAir);
+        a.update();
+        assert_eq!(count(&mut a), 2);
+        a.update();
+        assert_eq!(count(&mut a), 2);
+        send(&mut a, SkateSound::ChristAir);
+        a.update();
+        assert_eq!(count(&mut a), 2);
+    }
+    #[test]
+    fn menu_exit_and_map_teardown_clear_voices_and_pending_cues() {
+        for boundary in 0..3 {
+            let mut a = app();
+            send(&mut a, SkateSound::ChristAir);
+            a.update();
+            match boundary {
+                0 => {
+                    a.world_mut()
+                        .resource_mut::<frame::SkateMode>()
+                        .input_blocked = true
+                }
+                1 => a.world_mut().resource_mut::<frame::SkateMode>().active = false,
+                _ => {
+                    a.world_mut().remove_resource::<frame::AppScreen>();
+                }
+            }
+            send(&mut a, SkateSound::Land);
+            a.update();
+            assert_eq!(count(&mut a), 0);
+            assert!(a.world().resource::<SkateSoundQueue>().0.is_empty());
+        }
+    }
+    #[test]
+    fn missing_clip_and_invalid_gain_are_silent() {
+        let mut a = app();
+        a.world_mut().resource_mut::<Clips>().land = None;
+        a.world_mut().resource_mut::<Clips>().music = None;
+        send(&mut a, SkateSound::Land);
+        a.world_mut()
+            .resource_mut::<SkateSoundQueue>()
+            .0
+            .push((SkateSound::Pop, f32::NAN));
+        a.update();
+        assert_eq!(count(&mut a), 0);
+    }
+
+    #[test]
+    fn boarding_starts_music_once_and_menu_resume_does_not_restart_it() {
+        let mut a = app();
+        a.update();
+        assert_eq!(count(&mut a), 1);
+        a.update();
+        assert_eq!(count(&mut a), 1);
+        a.world_mut()
+            .resource_mut::<frame::SkateMode>()
+            .input_blocked = true;
+        a.update();
+        assert_eq!(count(&mut a), 0);
+        a.world_mut()
+            .resource_mut::<frame::SkateMode>()
+            .input_blocked = false;
+        a.update();
+        assert_eq!(count(&mut a), 0);
+        a.world_mut().resource_mut::<frame::SkateMode>().active = false;
+        a.update();
+        a.world_mut().resource_mut::<frame::SkateMode>().active = true;
+        a.update();
+        assert_eq!(count(&mut a), 1);
+    }
+}
