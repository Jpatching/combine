diff --git a/skate/crates/skate-host/src/physics/bridge_audio.rs b/skate/crates/skate-host/src/physics/bridge_audio.rs
new file mode 100644
--- /dev/null
+++ b/skate/crates/skate-host/src/physics/bridge_audio.rs
@@ -0,0 +1,173 @@
+//! Local sound cues from completed Skate simulation ticks, never raw buttons.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum SoundKind {
+    Pop,
+    Land,
+    ChristAir,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct SoundEvent {
+    pub kind: SoundKind,
+    pub gain: f32,
+}
+
+#[derive(Clone, Copy, Default)]
+pub(super) struct SoundFrame {
+    pub state: u32,
+    pub jump: bool,
+    pub christ_air: bool,
+    pub velocity_y: f32,
+}
+
+#[derive(Default)]
+pub(super) struct SoundTracker {
+    previous: Option<SoundFrame>,
+    airborne_seconds: f32,
+    fall_speed: f32,
+    music_cooldown: f32,
+    air_cued: bool,
+}
+
+fn air(state: u32) -> bool {
+    matches!(state, 200..=202)
+}
+fn board(state: u32) -> bool {
+    matches!(state, 100..=104 | 400..=405)
+}
+
+impl SoundTracker {
+    pub fn observe(&mut self, now: SoundFrame, dt: f32) -> Vec<SoundEvent> {
+        if !dt.is_finite() || dt <= 0.0 || dt > 0.25 || !now.velocity_y.is_finite() {
+            *self = Self::default();
+            return Vec::new();
+        }
+        self.music_cooldown = (self.music_cooldown - dt).max(0.0);
+        let Some(before) = self.previous.replace(now) else {
+            return Vec::new();
+        };
+        // Teleports, biped movement and sleep break the board sound sequence.
+        if !air(now.state) && !board(now.state) && now.state != 300 {
+            self.airborne_seconds = 0.0;
+            self.fall_speed = 0.0;
+            self.air_cued = false;
+            return Vec::new();
+        }
+        let mut events = Vec::new();
+        if now.jump && !before.jump && (board(before.state) || air(before.state)) {
+            events.push(SoundEvent {
+                kind: SoundKind::Pop,
+                gain: 0.8,
+            });
+        }
+        if air(now.state) {
+            self.airborne_seconds += dt;
+            self.fall_speed = self.fall_speed.max(-now.velocity_y);
+            if now.christ_air && !before.christ_air && !self.air_cued && self.music_cooldown == 0.0
+            {
+                events.push(SoundEvent {
+                    kind: SoundKind::ChristAir,
+                    gain: 0.32,
+                });
+                self.air_cued = true;
+                self.music_cooldown = 10.0;
+            }
+        } else {
+            if air(before.state) && self.airborne_seconds >= 0.05 && self.fall_speed >= 0.25 {
+                events.push(SoundEvent {
+                    kind: SoundKind::Land,
+                    gain: (0.35 + self.fall_speed * 0.06).clamp(0.35, 1.0),
+                });
+            }
+            self.airborne_seconds = 0.0;
+            self.fall_speed = 0.0;
+            self.air_cued = false;
+        }
+        events
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn frame(state: u32, vy: f32) -> SoundFrame {
+        SoundFrame {
+            state,
+            velocity_y: vy,
+            ..Default::default()
+        }
+    }
+    #[test]
+    fn held_jump_and_landing_emit_once_each() {
+        let mut t = SoundTracker::default();
+        assert!(t.observe(frame(100, 0.0), 0.02).is_empty());
+        let jump = SoundFrame {
+            jump: true,
+            ..frame(200, 3.0)
+        };
+        assert_eq!(t.observe(jump, 0.02)[0].kind, SoundKind::Pop);
+        for _ in 0..10 {
+            assert!(t.observe(jump, 0.02).is_empty());
+        }
+        t.observe(frame(200, -4.0), 0.02);
+        let e = t.observe(frame(100, 0.0), 0.02);
+        assert_eq!(e.len(), 1);
+        assert_eq!(e[0].kind, SoundKind::Land);
+        assert!(t.observe(frame(100, 0.0), 0.02).is_empty());
+    }
+    #[test]
+    fn falling_has_no_pop_but_a_real_landing() {
+        let mut t = SoundTracker::default();
+        t.observe(frame(100, 0.0), 0.02);
+        for _ in 0..5 {
+            assert!(t.observe(frame(200, -2.0), 0.02).is_empty());
+        }
+        assert_eq!(t.observe(frame(100, 0.0), 0.02)[0].kind, SoundKind::Land);
+    }
+    #[test]
+    fn activation_teleport_biped_and_short_contact_do_not_land() {
+        for state in [702, 500, 501, 700] {
+            let mut t = SoundTracker::default();
+            t.observe(frame(200, -9.0), 0.02);
+            for _ in 0..5 {
+                t.observe(frame(200, -9.0), 0.02);
+            }
+            assert!(t.observe(frame(state, 0.0), 0.02).is_empty());
+            assert!(t.observe(frame(100, 0.0), 0.02).is_empty());
+        }
+        let mut t = SoundTracker::default();
+        t.observe(frame(100, 0.0), 0.02);
+        t.observe(frame(200, -1.0), 0.02);
+        assert!(t.observe(frame(100, 0.0), 0.02).is_empty());
+    }
+    #[test]
+    fn christ_air_is_one_cue_with_cooldown() {
+        let mut t = SoundTracker::default();
+        t.observe(frame(100, 0.0), 0.02);
+        let pose = SoundFrame {
+            christ_air: true,
+            ..frame(200, 1.0)
+        };
+        assert_eq!(t.observe(pose, 0.02)[0].kind, SoundKind::ChristAir);
+        for _ in 0..20 {
+            assert!(t.observe(pose, 0.02).is_empty());
+        }
+        t.observe(frame(100, 0.0), 0.02);
+        assert!(t.observe(pose, 0.02).is_empty());
+        for _ in 0..501 {
+            t.observe(frame(100, 0.0), 0.02);
+        }
+        assert_eq!(t.observe(pose, 0.02)[0].kind, SoundKind::ChristAir);
+    }
+    #[test]
+    fn reset_and_invalid_samples_cannot_replay_old_impacts() {
+        let mut t = SoundTracker::default();
+        t.observe(frame(200, -5.0), 0.02);
+        for _ in 0..5 {
+            t.observe(frame(200, -5.0), 0.02);
+        }
+        assert!(t.observe(frame(200, f32::NAN), 0.02).is_empty());
+        assert!(t.observe(frame(100, 0.0), 0.02).is_empty());
+        assert!(t.observe(frame(200, -5.0), f32::NAN).is_empty());
+    }
+}
