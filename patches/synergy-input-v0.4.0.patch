+        p.digital_mut().press(B::LeftThumb);p.digital_mut().press(B::RightTrigger2);
+        p.analog_mut().set(bevy::input::gamepad::GamepadAxis::LeftStickY,1.);
+        p.analog_mut().set(bevy::input::gamepad::GamepadAxis::RightStickX,1.);
+    }
