@@ -0,0 +1,56 @@
+//! Physical input adapter for the original Synergy script. Gameplay uses the
+//! existing modal capture path; only the menu receives the raw button sample.
+use bevy::prelude::*;
+use bevy::input::mouse::MouseMotion;
+use crate::binds::BindInputs;
+
+#[derive(Resource, Default)]
+pub(crate) struct SynergyInput { pub captured: bool }
+#[derive(Default)]
+pub(crate) struct DeviceBarrier {
+    generation: Option<u64>, pad: Option<Entity>, focused: bool, waiting: bool,
+}
+pub(crate) fn sample(
+    mut state: ResMut<SynergyInput>,
+    mut world: Option<ResMut<net::AuthorityWorld>>,
+    local: Res<net::LocalPresentClient>,
+    snapshot: Res<net::PresentedSnapshot>,
+    generation: Res<frame::WorldGeneration>,
+    devices: Res<frame::InputDevices>,
+    active: Res<frame::ActivePad>,
+    pads: Query<&Gamepad>,
+    keys: Res<ButtonInput<KeyCode>>,
+    mouse: Res<ButtonInput<MouseButton>>,
+    (binds, scripted, console, settings): (Res<crate::KeyBinds>, Res<crate::ConsoleInputState>, Res<crate::ConsoleState>, Res<frame::GameSettings>),
+    (mut motion, mut barrier): (MessageReader<MouseMotion>, Local<DeviceBarrier>),
+) {
+    let pad = active.0.and_then(|id| pads.get(id).ok());
+    let inputs = BindInputs::new(&keys, &mouse).with_pad(pad);
+    let mut raw = 0;
+    for (button, _) in binds.iter() {
+        if inputs.pressed(button) {
+            raw |= binds.binding_name(button).map_or(0, sim::synergy_input::synergy_button_mask);
+        }
+    }
+    let mut scripted_down = false;
+    for id in scripted.ids() {
+        scripted_down = true;
+        if let Some(name) = input_iw4::command_name(id) { raw |= sim::synergy_input::synergy_button_mask(name); }
+    }
+    let mouse_moved = motion.read().any(|e| e.delta != Vec2::ZERO);
+    let neutral = keys.get_pressed().next().is_none() && mouse.get_pressed().next().is_none()
+        && !scripted_down && !mouse_moved
+        && pad.is_none_or(|p| p.get_pressed().next().is_none()
+            && p.get(bevy::input::gamepad::GamepadButton::LeftTrigger2).unwrap_or(0.) < 0.1
+            && p.get(bevy::input::gamepad::GamepadButton::RightTrigger2).unwrap_or(0.) < 0.1
+            && crate::gamepad::sticks(p, &settings) == crate::gamepad::Sticks::default());
+    if barrier.generation != generation.0 || barrier.pad != active.0 || !devices.focused || !barrier.focused {
+        barrier.waiting = true;
+    }
+    barrier.generation = generation.0; barrier.pad = active.0; barrier.focused = devices.focused;
+    let available = devices.focused && !console.open && !barrier.waiting
+        && snapshot.alive_player(local.0).is_some();
+    if devices.focused && neutral { barrier.waiting = false; }
+    let awaiting_device_release = std::env::var("COMBINE_SYNERGY_GSC").as_deref() == Ok("1") && barrier.waiting;
+    state.captured = world.as_deref_mut().is_some_and(|w| w.0.sample_synergy_input(local.0, raw, neutral, available)) || awaiting_device_release;
+}
