+/// Only adapt the input boundary. Presentation, hierarchy and actions stay upstream.
+pub(crate) fn compatible_source() -> Vec<u8> {
+    let source = std::str::from_utf8(SOURCE).expect("pinned Synergy is UTF-8");
+    let start = source.find("input_manager() {").expect("pinned input manager");
+    let end = start + source[start..].find("\nplayer_connect() {").expect("pinned input manager end");
+    let mut manager = source[start..end].to_owned();
+    for (method, command) in [
+        ("adsButtonPressed()", "+speed_throw"), ("meleeButtonPressed()", "+melee"),
+        ("attackButtonPressed()", "+attack"), ("useButtonPressed()", "+activate"),
+        ("fragButtonPressed()", "+frag"), ("secondaryOffhandButtonPressed()", "+smoke"),
+    ] {
+        assert!(manager.contains(method), "pinned input method missing");
+        manager = manager.replace(method, &format!("combineMenuButtonPressed(\"{command}\")"));
+    }
+    let source = format!("{}{}{}", &source[..start], manager, &source[end..]);
+    let source = source.replace("self.hud_created = true;", "self.hud_created = true;\n\tself combineMenuState(0);");
+    let source = source.replace("self.in_menu = true;", "self.in_menu = true;\n\tself combineMenuState(1);");
+    source.replace("close_menu() {\n\tset_menu_visibility(0);", "close_menu() {\n\tself combineMenuState(0);\n\tset_menu_visibility(0);").into_bytes()
+}
