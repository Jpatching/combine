+++ b/crates/sim/examples/synergy_probe.rs
@@ -0,0 +1,42 @@
+//! Compile-only compatibility probe. Empty imported modules are diagnostic placeholders.
+//! This does not execute the menu or prove that game-script helpers are implemented.
+use sim::script::{Catalog, Program, SourceResolver};
+use std::collections::BTreeMap;
+
+struct Sources { menu: String, helpers: BTreeMap<String, String> }
+impl SourceResolver for Sources {
+    fn read(&self, module: &str) -> Result<String, String> {
+        if module == "maps/mp/synergy" {
+            Ok(self.menu.clone())
+        } else {
+            Ok(self.helpers.get(module).cloned().unwrap_or_default())
+        }
+    }
+}
+
+fn main() {
+    let path = std::env::args().nth(1).expect("Synergy.gsc path");
+    let bytes = std::fs::read(path).expect("read source");
+    let mut sources = Sources { menu: sim::script::decode_source(&bytes), helpers: BTreeMap::new() };
+    for _ in 0..100 {
+        match Program::load(&sources, &["maps/mp/synergy"], &Catalog::iw4()) {
+            Ok(program) => {
+                println!("PARSE/LINK PROBE ONLY: {} modules, {} functions, {} natives; imported helpers are placeholders, not runtime support", program.modules().len(), program.function_count(), program.native_count());
+                return;
+            }
+            Err(error) => {
+                let name = error.message.split_whitespace().last().unwrap_or("");
+                if !error.message.starts_with("unresolved ") || !name.chars().all(|c| c.is_ascii_alphanumeric() || "_/:".contains(c)) {
+                    eprintln!("COMPATIBILITY FAILURE: {error}"); std::process::exit(1);
+                }
+                println!("EXTERNAL SYMBOL: {name}");
+                let (module, function) = name.split_once("::").unwrap_or(("common_scripts/utility", name));
+                let code = sources.helpers.entry(module.to_owned()).or_default();
+                let declaration = format!("{function}() {{}}\n");
+                assert!(!code.contains(&declaration), "unresolved symbol persisted");
+                code.push_str(&declaration);
+            }
+        }
+    }
+    panic!("diagnostic symbol limit");
+}
