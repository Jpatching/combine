+    *a.world_mut().get_mut::<Gamepad>(pad).unwrap() = Gamepad::default();
+    for _ in 0..4 { a.world_mut().run_system(sample).unwrap(); }
+    crate::plugin::poll_synergy_test_input(&mut a);
