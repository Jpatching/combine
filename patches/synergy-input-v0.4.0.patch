diff --git a/crates/sim/src/synergy_input.rs b/crates/sim/src/synergy_input.rs
new file mode 100644
--- /dev/null
+++ b/crates/sim/src/synergy_input.rs
@@ -0,0 +1,162 @@
+//! Local Synergy compatibility only; no network or general mod input API.
+use crate::{ClientId, SimWorld};
+use crate::script::{NativeRegistry, Namespace, Runtime, Value};
+use crate::script::host::args::string;
+use playerstate_iw4::{buttons, UserCmd};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum CapturePhase { #[default] Gameplay, Opening, Menu, WaitingForRelease }
+
+#[derive(Clone, Debug, Default)]
+pub(crate) struct MenuInput {
+    pub ready: bool,
+    pub open: bool,
+    pub phase: CapturePhase,
+    raw: u32,
+    available: bool,
+    release_frame: bool,
+}
+impl MenuInput {
+    fn sample(&mut self, raw: u32, neutral: bool, available: bool) -> bool {
+        self.release_frame = false;
+        let available = available && self.ready;
+        if !available || (!self.available && available) {
+            self.phase = CapturePhase::WaitingForRelease;
+        }
+        self.available = available;
+        self.raw = if available { raw } else { 0 };
+        if available {
+            match self.phase {
+                CapturePhase::WaitingForRelease if neutral => {
+                    self.phase = if self.open { CapturePhase::Menu } else { CapturePhase::Gameplay };
+                    self.raw = 0;
+                    self.release_frame = true;
+                    return true; // The release frame is consumed too.
+                }
+                CapturePhase::Gameplay if self.open => self.phase = CapturePhase::Menu,
+                CapturePhase::Gameplay if raw & (buttons::ADS | buttons::MELEE_CHARGE) == (buttons::ADS | buttons::MELEE_CHARGE) => self.phase = CapturePhase::Opening,
+                CapturePhase::Opening if self.open => self.phase = CapturePhase::Menu,
+                CapturePhase::Opening if neutral => self.phase = CapturePhase::WaitingForRelease,
+                CapturePhase::Menu if !self.open => self.phase = CapturePhase::WaitingForRelease,
+                _ => {}
+            }
+        }
+        self.captured()
+    }
+    fn captured(&self) -> bool { self.phase != CapturePhase::Gameplay || self.release_frame }
+    fn raw_buttons(&self) -> u32 {
+        if self.available && self.phase != CapturePhase::WaitingForRelease { self.raw } else { 0 }
+    }
+    fn set_open(&mut self, open: bool) {
+        self.ready = true;
+        self.open = open;
+        if open && self.available { self.phase = CapturePhase::Menu; }
+        else if !open && self.captured() { self.phase = CapturePhase::WaitingForRelease; }
+    }
+}
+
+/// Use configured bindings for both keyboard and controller menu controls.
+pub fn synergy_button_mask(command: &str) -> u32 { crate::script::command_buttons(command) }
+
+impl SimWorld {
+    /// Local input adapter only. `available` includes focus, life and device-release readiness.
+    /// Returns whether gameplay must be blocked before command generation/prediction.
+    pub fn sample_synergy_input(&mut self, client: ClientId, raw: u32, neutral: bool, available: bool) -> bool {
+        let mut runtime = self.ecs.resource_mut::<Runtime>();
+        runtime.synergy.get_mut(&client.0).is_some_and(|s| s.sample(raw, neutral, available))
+    }
+    pub fn synergy_capture_phase(&self, client: ClientId) -> CapturePhase {
+        self.ecs.resource::<Runtime>().synergy.get(&client.0).map_or(CapturePhase::Gameplay, |s| s.phase)
+    }
+}
+
+pub(crate) fn register(registry: &mut NativeRegistry) {
+    registry.register(Namespace::Method, "combinemenustate", |world, receiver, args| {
+        let client = crate::script::host::natives::player::player(world, receiver)?;
+        let open = crate::script::host::args::int(args, 0)? != 0;
+        world.resource_mut::<Runtime>().synergy.entry(client).or_default().set_open(open);
+        Ok(Value::Undefined)
+    });
+    registry.register(Namespace::Method, "combinemenubuttonpressed", |world, receiver, args| {
+        let client = crate::script::host::natives::player::player(world, receiver)?;
+        let command = string(args, 0)?;
+        let mask = synergy_button_mask(&command);
+        if mask == 0 { return Err("unknown Synergy menu button".into()); }
+        let raw = world.resource::<Runtime>().synergy.get(&client).map_or(0, |s| s.raw_buttons());
+        Ok(Value::Int((raw & mask != 0).into()))
+    });
+}
+
+/// Before scheduler/native button readers, command notifications, movement and weapons.
+/// Deliberate GSC weapon switches remain in ScriptControls and apply subsequently.
+pub(crate) fn filter(world: &mut bevy_ecs::world::World) {
+    // Ordinary GSC readers fall back to previous buttons on commandless ticks.
+    // Clear that fallback too; raw navigation remains solely in MenuInput.
+    let captured_clients: Vec<_> = world.resource::<Runtime>().synergy.iter()
+        .filter(|(_, input)| input.captured()).map(|(id, _)| *id).collect();
+    for (id, buttons) in crate::frame::FrameWorld::from_world(world).old_buttons_mut() {
+        if captured_clients.contains(&id.0) { *buttons = 0; }
+    }
+    let commands = world.resource::<crate::step::StepRequest>().input.cmds.clone();
+    let mut filtered = Vec::with_capacity(commands.len());
+    for (id, mut cmd) in commands {
+        let captured = world.resource::<Runtime>().synergy.get(&id.0).is_some_and(MenuInput::captured);
+        if captured {
+            let frame = crate::frame::FrameWorld::from_world(world);
+            if let Some(ps) = frame.player(id) {
+                let stance = if ps.e_flags & playerstate_iw4::eflags::PRONE != 0 { buttons::PRONE }
+                    else if ps.e_flags & playerstate_iw4::eflags::DUCK != 0 { buttons::CROUCH } else { 0 };
+                cmd = UserCmd {
+                    server_time: cmd.server_time,
+                    buttons: stance,
+                    angles: std::array::from_fn(|i| (((ps.viewangles[i] - ps.delta_angles[i]) * movement_iw4::ANGLE2SHORT) as i32) & 65535),
+                    weapon: ps.weapon as u16,
+                    weapon_mapped: ps.weapon as u16,
+                    ..Default::default()
+                };
+            } else { cmd = UserCmd { server_time: cmd.server_time, ..Default::default() }; }
+        }
+        filtered.push((id, cmd));
+    }
+    world.resource_mut::<crate::step::StepRequest>().input.cmds = filtered;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn ready() -> MenuInput {
+        let mut s=MenuInput::default(); s.set_open(false);
+        s.sample(0,true,true); s.sample(0,true,true); s
+    }
+    #[test]
+    fn synergy_open_navigation_close_waits_for_release() {
+        let mut s=ready();
+        assert!(s.sample(buttons::ADS|buttons::MELEE_CHARGE,false,true));
+        assert_eq!(s.phase,CapturePhase::Opening);
+        s.set_open(true);
+        assert!(s.sample(buttons::ATTACK,false,true));
+        assert_eq!(s.raw_buttons(),buttons::ATTACK);
+        s.set_open(false);
+        for _ in 0..10 { assert!(s.sample(buttons::ATTACK,false,true)); assert_eq!(s.raw_buttons(),0); }
+        assert!(s.sample(0,true,true));
+        assert!(s.captured(), "the simulation must also consume the release frame");
+        assert!(!s.sample(buttons::ATTACK,false,true));
+    }
+    #[test]
+    fn synergy_focus_death_and_reconnect_require_neutral() {
+        let mut s=ready();s.set_open(true);
+        assert!(s.sample(buttons::ATTACK,false,false));assert_eq!(s.raw_buttons(),0);
+        assert!(s.sample(buttons::ATTACK,false,true));assert_eq!(s.raw_buttons(),0);
+        assert!(s.sample(0,true,true));
+        assert!(s.sample(buttons::ATTACK,false,true));assert_eq!(s.raw_buttons(),buttons::ATTACK);
+        s.set_open(false);assert!(s.sample(0,true,false));
+        assert!(s.sample(buttons::ADS|buttons::MELEE_CHARGE,false,true));
+        assert_eq!(s.phase,CapturePhase::WaitingForRelease);
+        s.sample(0,true,true); assert!(!s.sample(0,true,true));
+    }
+    #[test]
+    fn synergy_unacknowledged_open_can_recover() {
+        let mut s=ready();s.sample(buttons::ADS|buttons::MELEE_CHARGE,false,true);
+        s.sample(0,true,true); s.sample(0,true,true);assert!(!s.sample(0,true,true));
+    }
+}
