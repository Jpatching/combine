+// SPDX-License-Identifier: GPL-3.0-only
+//! Synthetic ECS integration tests; no game assets or network, no claim of gameplay.
+use super::*;
+use crate::practice_menu::Page;
+use bevy::ecs::system::RunSystemOnce;
+use bevy::input::{
+    ButtonState, InputPlugin,
+    keyboard::{Key, NativeKey},
+};
+
+fn app() -> App {
+    let mut a = App::new();
+    let mut world = sim::SimWorld::new();
+    world
+        .bootstrap(sim::MatchBootstrap {
+            allow_debug_actions: true,
+            ..default()
+        })
+        .unwrap();
+    let mut snap = sim::Snapshot::unpublished(sim::Tick(1));
+    let mut ps = playerstate_iw4::PlayerState::ZERO;
+    ps.origin = [10., 20., 30.];
+    ps.viewangles = [0., 90., 0.];
+    ps.view_height_current = 60.;
+    snap.players.push((sim::ClientId(0), ps));
+    snap.meta.clients.push((
+        sim::ClientId(0),
+        sim::ClientSnapshotMeta {
+            lifecycle: sim::ClientLifecycle::Alive,
+            ..default()
+        },
+    ));
+    let mut presented = PresentedSnapshot::default();
+    presented.publish_decoded(snap);
+    let mut binds = crate::KeyBinds::default();
+    binds.apply_defaults();
+    binds.apply_pad_layout(0);
+    a.add_plugins(InputPlugin)
+        .insert_resource(Time::<()>::default())
+        .init_resource::<Practice>()
+        .insert_resource(RuntimeRole::Listen)
+        .insert_resource(AuthorityWorld(world))
+        .insert_resource(WorldGeneration(Some(1)))
+        .insert_resource(presented)
+        .insert_resource(LocalPresentClient(sim::ClientId(0)))
+        .init_resource::<frame::ActivePad>()
+        .insert_resource(frame::InputDevices {
+            focused: true,
+            ..default()
+        })
+        .init_resource::<ConsoleState>()
+        .insert_resource(AppScreen::InGame)
+        .init_resource::<BotRoster>()
+        .init_resource::<BotAddQueue>()
+        .init_resource::<BotHold>()
+        .init_resource::<BotTpQueue>()
+        .init_resource::<frame::SkateMode>()
+        .init_resource::<frame::GameSettings>()
+        .init_resource::<ClientActionInbox>()
+        .init_resource::<ActionRequestIds>()
+        .init_resource::<net::LookState>()
+        .init_resource::<frame::HudInputView>()
+        .init_resource::<net::ClientActionInput>()
+        .init_resource::<crate::ConsoleInputState>()
+        .insert_resource(binds)
+        .init_resource::<net::ClientPredictionState>()
+        .init_resource::<frame::UiBindingCapture>()
+        .add_message::<frame::UiMenuRequest>();
+    crate::plugin::install_practice_test_input(&mut a);
+    a.update();
+    a
+}
+fn key(a: &mut App, code: KeyCode, down: bool) {
+    a.world_mut().write_message(KeyboardInput {
+        key_code: code,
+        logical_key: Key::Unidentified(NativeKey::Unidentified),
+        state: if down {
+            ButtonState::Pressed
+        } else {
+            ButtonState::Released
+        },
+        text: None,
+        repeat: false,
+        window: Entity::PLACEHOLDER,
+    });
+    a.update();
+}
+fn tap(a: &mut App, code: KeyCode) {
+    key(a, code, true);
+    key(a, code, false);
+}
+fn page(a: &mut App, p: Page, selected: usize) {
+    let mut s = a.world_mut().resource_mut::<Practice>();
+    s.menu.page = p;
+    s.menu.cursor.selected = selected;
+}
+fn open(a: &mut App) {
+    tap(a, KeyCode::F6);
+}
+#[test]
+fn practice_keyboard_escape_consumed_and_held_keys_blocked_until_release() {
+    let mut a = app();
+    open(&mut a);
+    assert!(a.world().resource::<Practice>().menu.open);
+    key(&mut a, KeyCode::Space, true);
+    key(&mut a, KeyCode::KeyJ, true);
+    key(&mut a, KeyCode::Escape, true);
+    assert!(!a.world().resource::<Practice>().menu.open);
+    assert!(
+        !a.world()
+            .resource::<ButtonInput<KeyCode>>()
+            .just_pressed(KeyCode::Escape)
+    );
+    for _ in 0..3 {
+        a.update();
+        assert!(a.world().resource::<Practice>().captured);
+        assert!(!a.world().resource::<frame::SkateMode>().toggle_requested);
+        assert!(
+            a.world()
+                .resource::<net::ClientActionInput>()
+                .client
+                .keys
+                .iter()
+                .all(|k| k.down == 0)
+        );
+    }
+    key(&mut a, KeyCode::Escape, false);
+    key(&mut a, KeyCode::Space, false);
+    key(&mut a, KeyCode::KeyJ, false);
+    a.update();
+    assert!(!a.world().resource::<Practice>().captured);
+    tap(&mut a, KeyCode::KeyJ);
+    assert!(a.world().resource::<frame::SkateMode>().toggle_requested);
+}
+#[test]
+fn practice_missing_save_bot_and_restore_keep_menu_open() {
+    let mut a = app();
+    open(&mut a);
+    for (p, row, expected) in [
+        (Page::Positions, 1, "Save a starting"),
+        (Page::Targets, 1, "No living bot"),
+        (Page::Aim, 2, "No preset"),
+    ] {
+        page(&mut a, p, row);
+        tap(&mut a, KeyCode::Enter);
+        let s = a.world().resource::<Practice>();
+        assert!(s.menu.open);
+        assert!(s.status.starts_with(expected), "{}", s.status);
+    }
+    assert_eq!(a.world().resource::<ClientActionInbox>().pending_len(), 0);
+    assert!(a.world().resource::<BotTpQueue>().0.is_empty());
+}
+#[test]
+fn practice_save_return_exits_skating_then_queues_move_and_map_clears_state() {
+    let mut a = app();
+    open(&mut a);
+    page(&mut a, Page::Positions, 0);
+    tap(&mut a, KeyCode::Enter);
+    let saved = a.world().resource::<Practice>().saved.unwrap();
+    a.world_mut().resource_mut::<frame::SkateMode>().active = true;
+    page(&mut a, Page::Positions, 1);
+    tap(&mut a, KeyCode::Enter);
+    assert!(a.world().resource::<frame::SkateMode>().toggle_requested);
+    assert_eq!(a.world().resource::<ClientActionInbox>().pending_len(), 0);
+    a.world_mut().resource_mut::<frame::SkateMode>().active = false;
+    a.update();
+    let inbox = a.world().resource::<ClientActionInbox>();
+    assert!(
+        matches!(inbox.pending()[0].1, sim::ClientAction::Move { origin, angles, .. } if origin == saved.origin && angles == saved.angles)
+    );
+    a.world_mut().resource_mut::<Practice>().aim_lock = true;
+    a.world_mut().resource_mut::<WorldGeneration>().0 = Some(2);
+    a.update();
+    let s = a.world().resource::<Practice>();
+    assert!(s.saved.is_none() && s.pending_return.is_none() && !s.aim_lock && !s.menu.open);
+}
+#[test]
+fn practice_return_timeout_and_missing_authority_queue_are_visible() {
+    let mut a = app();
+    open(&mut a);
+    page(&mut a, Page::Positions, 0);
+    tap(&mut a, KeyCode::Enter);
+    a.world_mut().remove_resource::<ClientActionInbox>();
+    page(&mut a, Page::Positions, 1);
+    tap(&mut a, KeyCode::Enter);
+    assert!(
+        a.world()
+            .resource::<Practice>()
+            .status
+            .contains("no local authority")
+    );
+    a.world_mut().resource_mut::<frame::SkateMode>().active = true;
+    tap(&mut a, KeyCode::Enter);
+    a.world_mut()
+        .resource_mut::<Time>()
+        .advance_by(std::time::Duration::from_secs(3));
+    a.update();
+    let s = a.world().resource::<Practice>();
+    assert!(s.menu.open && s.pending_return.is_none());
+    assert!(s.status.contains("Return cancelled"));
+}
+#[test]
+fn practice_bot_queue_freeze_and_preset_restore() {
+    let mut a = app();
+    open(&mut a);
+    page(&mut a, Page::Targets, 0);
+    tap(&mut a, KeyCode::Enter);
+    assert!(a.world().resource::<BotAddQueue>().0[0].dummy);
+    page(&mut a, Page::Targets, 2);
+    tap(&mut a, KeyCode::Enter);
+    assert!(a.world().resource::<BotHold>().0);
+    a.world_mut()
+        .resource_mut::<frame::GameSettings>()
+        .pad_ads_sensitivity = 1.23;
+    page(&mut a, Page::Aim, 1);
+    tap(&mut a, KeyCode::Enter);
+    tap(&mut a, KeyCode::Enter);
+    assert_eq!(
+        a.world()
+            .resource::<frame::GameSettings>()
+            .pad_ads_sensitivity,
+        0.75
+    );
+    page(&mut a, Page::Aim, 2);
+    tap(&mut a, KeyCode::Enter);
+    assert_eq!(
+        a.world()
+            .resource::<frame::GameSettings>()
+            .pad_ads_sensitivity,
+        1.23
+    );
+}
+#[test]
+fn practice_pad_chord_select_back_and_gameplay_isolation() {
+    let mut a = app();
+    let pad = a.world_mut().spawn(Gamepad::default()).id();
+    a.world_mut().resource_mut::<frame::ActivePad>().0 = Some(pad);
+    // Directly mutate digital input after InputSystems, as a real pad event would.
+    fn buttons(a: &mut App, pad: Entity, buttons: &[B]) {
+        {
+            let mut p = a.world_mut().get_mut::<Gamepad>(pad).unwrap();
+            p.digital_mut().reset_all();
+            for &b in buttons {
+                p.digital_mut().press(b);
+            }
+        }
+        a.world_mut().run_system_once(input).unwrap();
+    }
+    buttons(&mut a, pad, &[B::LeftTrigger2, B::RightThumb]);
+    assert!(a.world().resource::<Practice>().menu.open);
+    buttons(&mut a, pad, &[]);
+    buttons(&mut a, pad, &[B::West]);
+    assert_eq!(a.world().resource::<Practice>().menu.page, Page::Positions);
+    buttons(&mut a, pad, &[]);
+    buttons(&mut a, pad, &[B::RightThumb]);
+    assert_eq!(a.world().resource::<Practice>().menu.page, Page::Root);
+    buttons(&mut a, pad, &[]);
+    buttons(
+        &mut a,
+        pad,
+        &[
+            B::LeftTrigger2,
+            B::RightThumb,
+            B::LeftThumb,
+            B::RightTrigger2,
+            B::South,
+        ],
+    );
+    assert!(!a.world().resource::<Practice>().menu.open);
+    // Run the complete ordered pipeline with those buttons still held.
+    a.update();
+    assert!(a.world().resource::<Practice>().captured);
+    assert!(!a.world().resource::<frame::SkateMode>().toggle_requested);
+    assert!(
+        a.world()
+            .resource::<net::ClientActionInput>()
+            .client
+            .keys
+            .iter()
+            .all(|k| k.down == 0)
+    );
+}
