+// SPDX-License-Identifier: GPL-3.0-only
+// Synergy MW2 presentation adapted for Combine, 2026-10-03.
+// See COMBINE-NOTICE.md for the source revision, authors and modifications.
+use crate::practice_menu::{Action, Entry, Page, VISIBLE_ROWS};
+use bevy::prelude::*;
+
+#[derive(Resource, Default, PartialEq, Clone)]
+pub(crate) struct MenuView {
+    pub open: bool,
+    pub page: Page,
+    pub selected: usize,
+    pub offset: usize,
+    pub frozen: bool,
+    pub aim_lock: bool,
+    pub pad: bool,
+    pub status: String,
+}
+#[derive(Component)]
+pub(crate) struct MenuRoot;
+
+/// A closed menu has no UI entities, so layer visibility cannot resurrect it.
+pub(crate) fn render(
+    mut commands: Commands,
+    view: Res<MenuView>,
+    font: Option<Res<ui::GameUiFont>>,
+    windows: Query<&Window, With<bevy::window::PrimaryWindow>>,
+    roots: Query<Entity, With<MenuRoot>>,
+    mut previous: Local<Option<(MenuView, Vec2)>>,
+) {
+    let viewport = windows
+        .single()
+        .map_or(Vec2::new(1280., 720.), |w| Vec2::new(w.width(), w.height()));
+    if previous
+        .as_ref()
+        .is_some_and(|(v, size)| v == &*view && *size == viewport)
+    {
+        return;
+    }
+    for entity in &roots {
+        commands.entity(entity).despawn();
+    }
+    if !view.open {
+        *previous = Some((view.clone(), viewport));
+        return;
+    }
+    let Some(font) = font else {
+        return;
+    };
+    *previous = Some((view.clone(), viewport));
+    let scale = (viewport.y / 720.).min(viewport.x / 1280.);
+    let cyan = Color::srgb(0.05, 0.85, 0.95);
+    let light = Color::srgb(0.88, 0.92, 0.95);
+    let muted = Color::srgb(0.56, 0.65, 0.69);
+    let dark = Color::srgb(0.025, 0.055, 0.065);
+    let text_font = |size| ui::game_text_font(&font.0, size * scale);
+    commands.spawn((
+        MenuRoot, ui::UiLayer::Overlay, GlobalZIndex(19500),
+        Node { position_type: PositionType::Absolute, width: percent(100), height: percent(100), ..default() },
+    )).with_children(|root| {
+        root.spawn((
+            Node {
+                position_type: PositionType::Absolute, right: px(32. * scale), top: px(144. * scale),
+                width: px(330. * scale), flex_direction: FlexDirection::Column,
+                border: UiRect::all(px(scale)), ..default()
+            },
+            BackgroundColor(Color::srgba(0.035, 0.045, 0.055, 0.9)), BorderColor::all(cyan),
+        )).with_children(|panel| {
+            panel.spawn((
+                Node { height: px(42. * scale), justify_content: JustifyContent::Center,
+                    align_items: AlignItems::Center, border: UiRect::bottom(px(scale)), ..default() },
+                BorderColor::all(cyan),
+            )).with_child((Text::new(view.page.title()), text_font(22.), TextColor(light)));
+            // Seven fixed slots as in Synergy; fewer actions leave empty slots.
+            for slot in 0..VISIBLE_ROWS {
+                let index = view.offset + slot;
+                let entry = view.page.entries().get(index).copied();
+                let selected = entry.is_some() && index == view.selected;
+                panel.spawn((
+                    Node { height: px(30. * scale), flex_shrink: 0., padding: UiRect::horizontal(px(12. * scale)),
+                        align_items: AlignItems::Center, justify_content: JustifyContent::SpaceBetween, ..default() },
+                    BackgroundColor(if selected { cyan } else { Color::NONE }),
+                )).with_children(|row| {
+                    if let Some(entry) = entry {
+                        row.spawn((Text::new(entry.label()), text_font(17.), TextColor(if selected { dark } else { light })));
+                        let suffix = match entry {
+                            Entry::Submenu(_) => ">",
+                            Entry::Action(Action::FreezeBots) => if view.frozen { "ON" } else { "OFF" },
+                            Entry::Action(Action::AimLock) => if view.aim_lock { "ON" } else { "OFF" },
+                            _ => "",
+                        };
+                        row.spawn((Text::new(suffix), text_font(17.), TextColor(if selected { dark } else { cyan })));
+                    }
+                });
+            }
+            panel.spawn((Node { min_height: px(44. * scale), padding: UiRect::all(px(10. * scale)),
+                border: UiRect::top(px(scale)), ..default() }, BorderColor::all(Color::srgba(0.05, 0.85, 0.95, 0.3)),
+            )).with_child((Text::new(if view.status.is_empty() { "Local bot practice" } else { &view.status }), text_font(14.), TextColor(light)));
+            let controls = if view.pad {
+                "D-pad / L2 R2: move   Cross / Square: select\nCircle / R3: back   L2 + R3: close"
+            } else { "Arrows: move   Enter: select   Backspace: back\nF6 / Esc: close" };
+            panel.spawn((Node { padding: UiRect::axes(px(10. * scale), px(7. * scale)),
+                flex_direction: FlexDirection::Column, row_gap: px(5. * scale), ..default() },
+                BackgroundColor(Color::srgba(0., 0., 0., 0.22)),
+            )).with_children(|footer| {
+                footer.spawn((Text::new(controls), text_font(12.), TextColor(muted)));
+                footer.spawn((Text::new("Synergy / SyndiShanX  ·  Combine port"), text_font(11.), TextColor(muted)));
+            });
+        });
+    });
+}
