+//! Pure practice policy/math; also testable with `rustc --test` without game assets.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Spot {
+    pub generation: u64,
+    pub origin: [f32; 3],
+    pub angles: [f32; 3],
+}
+impl Spot {
+    pub fn valid_for(self, generation: Option<u64>) -> bool {
+        generation == Some(self.generation)
+            && self
+                .origin
+                .iter()
+                .chain(self.angles.iter())
+                .all(|v| v.is_finite())
+    }
+}
+
+pub fn permitted(listen: bool, debug: bool, has_world: bool, other_humans: bool) -> bool {
+    listen && debug && has_world && !other_humans
+}
+
+/// Desired world pitch/yaw and angular error, for a visible target in a 30 degree cone.
+pub fn target_angles(eye: [f32; 3], target: [f32; 3], view: [f32; 3]) -> Option<([f32; 3], f32)> {
+    if !eye
+        .iter()
+        .chain(target.iter())
+        .chain(view.iter())
+        .all(|v| v.is_finite())
+    {
+        return None;
+    }
+    let d = std::array::from_fn::<_, 3, _>(|i| target[i] - eye[i]);
+    let horizontal = d[0].hypot(d[1]);
+    if horizontal.hypot(d[2]) < 0.01 {
+        return None;
+    }
+    let angles = [
+        -d[2].atan2(horizontal).to_degrees(),
+        d[1].atan2(d[0]).to_degrees(),
+        0.0,
+    ];
+    let pitch = view[0].to_radians();
+    let yaw = view[1].to_radians();
+    let forward = [
+        pitch.cos() * yaw.cos(),
+        pitch.cos() * yaw.sin(),
+        -pitch.sin(),
+    ];
+    let length = horizontal.hypot(d[2]);
+    let dot = (0..3)
+        .map(|i| forward[i] * d[i] / length)
+        .sum::<f32>()
+        .clamp(-1.0, 1.0);
+    let error = dot.acos().to_degrees();
+    (error <= 30.0).then_some((angles, error))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn practice_requires_local_debug_world_without_humans() {
+        assert!(permitted(true, true, true, false));
+        for args in [
+            (false, true, true, false),
+            (true, false, true, false),
+            (true, true, false, false),
+            (true, true, true, true),
+        ] {
+            assert!(!permitted(args.0, args.1, args.2, args.3));
+        }
+    }
+    #[test]
+    fn saved_spot_rejects_other_maps_and_nonfinite_data() {
+        let mut s = Spot {
+            generation: 7,
+            origin: [1., 2., 3.],
+            angles: [0.; 3],
+        };
+        assert!(s.valid_for(Some(7)));
+        assert!(!s.valid_for(Some(8)));
+        assert!(!s.valid_for(None));
+        s.origin[0] = f32::NAN;
+        assert!(!s.valid_for(Some(7)));
+    }
+    #[test]
+    fn aim_handles_yaw_wrap_and_vertical_pitch() {
+        let (a, error) = target_angles([0.; 3], [-100., -1., 0.], [0., 179., 0.]).unwrap();
+        assert!(a[1] < -179. && error < 2.);
+        let (a, _) = target_angles([0.; 3], [100., 0., 10.], [0.; 3]).unwrap();
+        assert!(a[0] < -5. && a[0] > -6.);
+    }
+    #[test]
+    fn aim_rejects_behind_outside_cone_zero_and_nonfinite() {
+        for p in [
+            [-10., 0., 0.],
+            [0., 10., 0.],
+            [0.; 3],
+            [f32::NAN, 0., 0.],
+            [f32::INFINITY, 0., 0.],
+        ] {
+            assert!(target_angles([0.; 3], p, [0.; 3]).is_none());
+        }
+    }
+}
