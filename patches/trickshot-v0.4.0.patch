+#[test]
+fn practice_aim_lock_excludes_humans_dead_teammates_and_obstructions() {
+    let mut a = app();
+    assert!(!a.world().resource::<Practice>().aim_lock);
+    let id = a
+        .world_mut()
+        .resource_mut::<BotRoster>()
+        .add_bots(1, &[sim::ClientId(0)], true)[0];
+    let mut snap = a
+        .world()
+        .resource::<PresentedSnapshot>()
+        .snapshot()
+        .unwrap()
+        .clone();
+    let mut target = playerstate_iw4::PlayerState::ZERO;
+    target.origin = [110., 25., 45.];
+    target.view_height_current = 60.;
+    snap.players.push((id, target));
+    snap.meta.clients.push((
+        id,
+        sim::ClientSnapshotMeta {
+            lifecycle: sim::ClientLifecycle::Alive,
+            ..default()
+        },
+    ));
+    a.world_mut()
+        .resource_mut::<PresentedSnapshot>()
+        .publish_decoded(snap.clone());
+    a.world_mut().resource_mut::<Practice>().aim_lock = true;
+    a.init_resource::<net::ClientCmdTemplate>();
+    fn run(a: &mut App, ads: bool) -> Option<u32> {
+        {
+            let mut t = a.world_mut().resource_mut::<net::ClientCmdTemplate>();
+            t.ready = true;
+            t.cmd.angles = [0; 3];
+            t.cmd.buttons = if ads {
+                playerstate_iw4::buttons::ADS
+            } else {
+                0
+            };
+        }
+        a.world_mut().run_system_once(aim_lock).unwrap();
+        a.world().resource::<Practice>().locked_bot
+    }
+    assert_eq!(run(&mut a, true), Some(id.0));
+    assert_eq!(run(&mut a, false), None);
+    a.world_mut().resource_mut::<frame::SkateMode>().active = true;
+    assert_eq!(run(&mut a, true), None);
+    a.world_mut().resource_mut::<frame::SkateMode>().active = false;
+    a.world_mut().resource_mut::<Practice>().captured = true;
+    assert_eq!(run(&mut a, true), None);
+    a.world_mut().resource_mut::<Practice>().captured = false;
+    let mut dead = snap.clone();
+    dead.meta.clients[1].1.lifecycle = sim::ClientLifecycle::Spectating;
+    a.world_mut()
+        .resource_mut::<PresentedSnapshot>()
+        .publish_decoded(dead);
+    assert_eq!(run(&mut a, true), None);
+    let mut team = snap.clone();
+    team.meta.kind = gamemode_iw4::GameModeKind::TeamDeathmatch;
+    a.world_mut()
+        .resource_mut::<PresentedSnapshot>()
+        .publish_decoded(team);
+    assert_eq!(run(&mut a, true), None);
+    let mut humans = snap.clone();
+    humans
+        .meta
+        .clients
+        .push((sim::ClientId(9), sim::ClientSnapshotMeta::default()));
+    a.world_mut()
+        .resource_mut::<PresentedSnapshot>()
+        .publish_decoded(humans);
+    assert_eq!(run(&mut a, true), None);
+    a.world_mut()
+        .resource_mut::<PresentedSnapshot>()
+        .publish_decoded(snap);
+    // A synthetic solid slab between the local eye and the target.
+    let mut content = sim::SimContentBuilder::default();
+    content.set_clip_brushes(vec![sim::SimBrush {
+        planes: vec![
+            [1., 0., 0., 60.],
+            [-1., 0., 0., -40.],
+            [0., 1., 0., 100.],
+            [0., -1., 0., 100.],
+            [0., 0., 1., 200.],
+            [0., 0., -1., 0.],
+        ],
+        contents: 1,
+        plane_surface_flags: vec![0; 6],
+        glass_encoded: 0,
+    }]);
+    a.world_mut()
+        .resource_mut::<AuthorityWorld>()
+        .0
+        .install_content(content.finish());
+    assert_eq!(run(&mut a, true), None);
+}
