+// SPDX-License-Identifier: GPL-3.0-only
+// Source-derived port of Synergy MW2 by SyndiShanX (M203 / Xeirh and
+// Apparition Structure Team). Revision 33bcc80f5446e7543a2eb68b17c798e29d3f27c4.
+// Adapted for Combine on 2026-10-03; see COMBINE-NOTICE.md and LICENSES/.
+//! Menu navigation only. Actions are typed requests, never executable strings.
+
+pub const VISIBLE_ROWS: usize = 7;
+const REPEAT_DELAY: f64 = 0.4;
+const REPEAT_EVERY: f64 = 0.12;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Action {
+    Save,
+    Return,
+    AddBot,
+    PlaceBot,
+    FreezeBots,
+    AimLock,
+    SmoothAim,
+    RestoreAim,
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Page {
+    #[default]
+    Root,
+    Positions,
+    Targets,
+    Aim,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Entry {
+    Submenu(Page),
+    Action(Action),
+}
+impl Page {
+    pub fn title(self) -> &'static str {
+        match self {
+            Self::Root => "TRICKSHOT",
+            Self::Positions => "POSITIONS",
+            Self::Targets => "TARGETS",
+            Self::Aim => "AIM",
+        }
+    }
+    pub fn entries(self) -> &'static [Entry] {
+        use Action::*;
+        use Entry::{Action as A, Submenu as S};
+        match self {
+            Self::Root => &[S(Self::Positions), S(Self::Targets), S(Self::Aim)],
+            Self::Positions => &[A(Save), A(Return)],
+            Self::Targets => &[A(AddBot), A(PlaceBot), A(FreezeBots)],
+            Self::Aim => &[A(AimLock), A(SmoothAim), A(RestoreAim)],
+        }
+    }
+}
+impl Entry {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Submenu(Page::Root) => "Trickshot",
+            Self::Submenu(Page::Positions) => "Positions",
+            Self::Submenu(Page::Targets) => "Targets",
+            Self::Submenu(Page::Aim) => "Aim",
+            Self::Action(a) => match a {
+                Action::Save => "Save starting spot",
+                Action::Return => "Return to starting spot",
+                Action::AddBot => "Add stationary bot",
+                Action::PlaceBot => "Place latest bot here",
+                Action::FreezeBots => "Freeze bots",
+                Action::AimLock => "Bot aim lock",
+                Action::SmoothAim => "Smooth controller preset",
+                Action::RestoreAim => "Restore settings",
+            },
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Cursor {
+    pub selected: usize,
+    pub offset: usize,
+}
+impl Cursor {
+    pub fn move_by(&mut self, down: bool, count: usize) {
+        if count == 0 {
+            *self = Self::default();
+            return;
+        }
+        self.selected = if down {
+            (self.selected + 1) % count
+        } else {
+            (self.selected + count - 1) % count
+        };
+        // Synergy keeps the cursor near the middle, with seven visible options.
+        self.offset = self
+            .selected
+            .saturating_sub(VISIBLE_ROWS / 2)
+            .min(count.saturating_sub(VISIBLE_ROWS));
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+pub struct Controls {
+    pub up: bool,
+    pub down: bool,
+    pub select: bool,
+    pub back: bool,
+    /// Edge only: F6 pressed, or R3 pressed while L2 is held.
+    pub toggle: bool,
+    pub escape: bool,
+    /// Physical keys, mouse buttons and pad buttons, even when gameplay keys reset.
+    pub any_down: bool,
+}
+#[derive(Default)]
+pub struct Menu {
+    pub open: bool,
+    pub captured: bool,
+    pub page: Page,
+    pub cursor: Cursor,
+    history: Vec<(Page, Cursor)>,
+    saved: [Cursor; 4],
+    release_guard: bool,
+    previous: Controls,
+    repeat: Option<(bool, f64)>,
+}
+impl Menu {
+    pub fn close(&mut self) {
+        if self.open {
+            self.release_guard = true;
+            self.captured = true;
+        }
+        self.open = false;
+        self.repeat = None;
+    }
+    pub fn reset(&mut self) {
+        self.close();
+        self.page = Page::Root;
+        self.cursor = Cursor::default();
+        self.history.clear();
+        self.saved = [Cursor::default(); 4];
+    }
+    pub fn step(&mut self, c: Controls, available: bool, now: f64) -> Option<Action> {
+        let old = self.previous;
+        self.previous = c;
+        self.captured = self.open || self.release_guard;
+        if !available {
+            self.close();
+        }
+        if self.release_guard {
+            self.release_guard = c.any_down;
+            // Capture the release frame too. Never re-open or act on a held button.
+            return None;
+        }
+        if !available {
+            return None;
+        }
+        if c.toggle {
+            if self.open {
+                self.close();
+            } else {
+                self.open = true;
+                self.captured = true;
+                self.release_guard = true;
+            }
+            return None;
+        }
+        if !self.open {
+            return None;
+        }
+        if c.escape {
+            self.close();
+            return None;
+        }
+        if c.back && !old.back {
+            self.saved[self.page as usize] = self.cursor;
+            if let Some((page, cursor)) = self.history.pop() {
+                self.page = page;
+                self.cursor = cursor;
+            } else {
+                self.close();
+            }
+            self.repeat = None;
+            return None;
+        }
+        if c.select && !old.select {
+            self.repeat = None;
+            match self.page.entries()[self.cursor.selected] {
+                Entry::Submenu(page) => {
+                    self.saved[self.page as usize] = self.cursor;
+                    self.history.push((self.page, self.cursor));
+                    self.page = page;
+                    self.cursor = self.saved[page as usize];
+                }
+                Entry::Action(action) => return Some(action),
+            }
+            return None;
+        }
+        let direction = if c.up == c.down { None } else { Some(c.down) };
+        match (direction, self.repeat) {
+            (Some(down), Some((held, next))) if down == held => {
+                if now >= next {
+                    self.cursor.move_by(down, self.page.entries().len());
+                    self.repeat = Some((down, now + REPEAT_EVERY));
+                }
+            }
+            (Some(down), _) => {
+                self.cursor.move_by(down, self.page.entries().len());
+                self.repeat = Some((down, now + REPEAT_DELAY));
+            }
+            (None, _) => self.repeat = None,
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn open(m: &mut Menu) {
+        m.step(
+            Controls {
+                toggle: true,
+                any_down: true,
+                ..Default::default()
+            },
+            true,
+            0.,
+        );
+        m.step(Controls::default(), true, 0.1);
+    }
+    fn tap(m: &mut Menu, c: Controls) -> Option<Action> {
+        let out = m.step(c, true, 1.);
+        m.step(Controls::default(), true, 1.1);
+        out
+    }
+    #[test]
+    fn starts_completely_closed_and_escape_does_not_open() {
+        let mut m = Menu::default();
+        assert!(!m.open && !m.captured);
+        tap(
+            &mut m,
+            Controls {
+                escape: true,
+                ..Default::default()
+            },
+        );
+        assert!(!m.open && !m.captured);
+    }
+    #[test]
+    fn submenu_backtracking_restores_parent_and_child_cursor() {
+        let mut m = Menu::default();
+        open(&mut m);
+        tap(
+            &mut m,
+            Controls {
+                down: true,
+                ..Default::default()
+            },
+        );
+        tap(
+            &mut m,
+            Controls {
+                select: true,
+                ..Default::default()
+            },
+        );
+        assert_eq!(m.page, Page::Targets);
+        tap(
+            &mut m,
+            Controls {
+                down: true,
+                ..Default::default()
+            },
+        );
+        assert_eq!(
+            tap(
+                &mut m,
+                Controls {
+                    select: true,
+                    ..Default::default()
+                }
+            ),
+            Some(Action::PlaceBot)
+        );
+        assert!(m.open); // Even failed actions leave navigation intact.
+        tap(
+            &mut m,
+            Controls {
+                back: true,
+                ..Default::default()
+            },
+        );
+        assert_eq!((m.page, m.cursor.selected), (Page::Root, 1));
+        tap(
+            &mut m,
+            Controls {
+                select: true,
+                ..Default::default()
+            },
+        );
+        assert_eq!((m.page, m.cursor.selected), (Page::Targets, 1));
+    }
+    #[test]
+    fn held_navigation_delays_repeats_and_opposites_cancel() {
+        let mut m = Menu::default();
+        open(&mut m);
+        let down = Controls {
+            down: true,
+            any_down: true,
+            ..Default::default()
+        };
+        m.step(down, true, 1.);
+        assert_eq!(m.cursor.selected, 1);
+        m.step(down, true, 1.39);
+        assert_eq!(m.cursor.selected, 1);
+        m.step(down, true, 1.4);
+        assert_eq!(m.cursor.selected, 2);
+        m.step(down, true, 1.51);
+        assert_eq!(m.cursor.selected, 2);
+        m.step(down, true, 1.53);
+        assert_eq!(m.cursor.selected, 0);
+        m.step(Controls { up: true, ..down }, true, 2.);
+        assert_eq!(m.cursor.selected, 0);
+    }
+    #[test]
+    fn scroll_window_wraps_and_contains_selection() {
+        let mut c = Cursor::default();
+        c.move_by(false, 12);
+        assert_eq!(
+            c,
+            Cursor {
+                selected: 11,
+                offset: 5
+            }
+        );
+        c.move_by(true, 12);
+        assert_eq!(c, Cursor::default());
+        for _ in 0..30 {
+            c.move_by(true, 12);
+            assert!(c.selected >= c.offset && c.selected < c.offset + VISIBLE_ROWS);
+            assert!(c.offset <= 5);
+        }
+        c.move_by(true, 0);
+        assert_eq!(c, Cursor::default());
+    }
+    #[test]
+    fn opening_chord_and_closing_buttons_require_release() {
+        let mut m = Menu::default();
+        let chord = Controls {
+            toggle: true,
+            up: true,
+            back: true,
+            any_down: true,
+            ..Default::default()
+        };
+        m.step(chord, true, 0.);
+        m.step(chord, true, 1.);
+        assert!(m.open && m.captured);
+        assert_eq!(m.cursor.selected, 0);
+        m.step(Controls::default(), true, 2.);
+        m.step(
+            Controls {
+                escape: true,
+                any_down: true,
+                ..Default::default()
+            },
+            true,
+            3.,
+        );
+        assert!(!m.open && m.captured);
+        m.step(chord, true, 4.);
+        assert!(!m.open && m.captured);
+        m.step(Controls::default(), true, 5.);
+        assert!(m.captured);
+        m.step(Controls::default(), true, 6.);
+        assert!(!m.captured);
+    }
+    #[test]
+    fn action_hold_never_repeats_and_context_loss_closes() {
+        let mut m = Menu::default();
+        open(&mut m);
+        tap(
+            &mut m,
+            Controls {
+                select: true,
+                ..Default::default()
+            },
+        );
+        let c = Controls {
+            select: true,
+            any_down: true,
+            ..Default::default()
+        };
+        assert_eq!(m.step(c, true, 2.), Some(Action::Save));
+        assert_eq!(m.step(c, true, 3.), None);
+        m.step(c, false, 4.);
+        assert!(!m.open && m.captured);
+        m.reset();
+        assert_eq!((m.page, m.cursor.selected), (Page::Root, 0));
+    }
+}
