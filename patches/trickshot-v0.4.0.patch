--- /dev/null
+++ b/crates/console/examples/practice_menu_preview.rs
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Asset-free native renderer check. Does not load a game, profile or network.
+//! Run with a fresh output directory; captures root, submenu, feedback and closed.
+#[path = "../src/practice_menu.rs"]
+mod practice_menu;
+#[path = "../src/practice_ui.rs"]
+mod practice_ui;
+use bevy::prelude::*;
+use bevy::render::view::screenshot::{Screenshot, ScreenshotCaptured, save_to_disk};
+use practice_menu::Page;
+use practice_ui::{MenuRoot, MenuView};
+
+#[derive(Resource)]
+struct Preview {
+    directory: String,
+    stage: usize,
+    frame: usize,
+    waiting: bool,
+}
+fn main() {
+    let args: Vec<_> = std::env::args().collect();
+    let width: u32 = args.get(1).expect("width").parse().unwrap();
+    let height: u32 = args.get(2).expect("height").parse().unwrap();
+    let directory = args.get(3).expect("fresh output directory").clone();
+    std::fs::create_dir(&directory).expect("output directory must be fresh");
+    App::new()
+        .add_plugins(
+            DefaultPlugins.set(WindowPlugin {
+                primary_window: Some(Window {
+                    title: "Combine menu preview - no game assets".into(),
+                    resolution: bevy::window::WindowResolution::new(width, height)
+                        .with_scale_factor_override(1.),
+                    ..default()
+                }),
+                ..default()
+            }),
+        )
+        .insert_resource(ClearColor(Color::srgb(0.16, 0.19, 0.23)))
+        .insert_resource(Preview {
+            directory,
+            stage: 0,
+            frame: 0,
+            waiting: false,
+        })
+        .init_resource::<MenuView>()
+        .add_systems(Startup, setup)
+        .add_systems(Update, (advance, practice_ui::render).chain())
+        .run();
+}
+fn setup(mut commands: Commands, mut fonts: ResMut<Assets<Font>>) {
+    let font = fonts.add(Font::from_bytes(
+        include_bytes!("../../ui/assets/Oxanium-Regular.ttf").to_vec(),
+    ));
+    commands.insert_resource(ui::GameUiFont(font));
+    commands.spawn(Camera2d);
+}
+fn advance(
+    mut commands: Commands,
+    mut p: ResMut<Preview>,
+    mut view: ResMut<MenuView>,
+    roots: Query<Entity, With<MenuRoot>>,
+    mut exit: MessageWriter<AppExit>,
+) {
+    if p.waiting {
+        return;
+    }
+    if p.stage >= 4 {
+        exit.write(AppExit::Success);
+        return;
+    }
+    p.frame += 1;
+    if p.frame == 1 {
+        *view = match p.stage {
+            0 => MenuView {
+                open: true,
+                ..default()
+            },
+            1 => MenuView {
+                open: true,
+                page: Page::Aim,
+                selected: 1,
+                pad: true,
+                ..default()
+            },
+            2 => MenuView {
+                open: true,
+                page: Page::Targets,
+                selected: 1,
+                status: "No living bot: add a target and wait for it to spawn.".into(),
+                ..default()
+            },
+            _ => MenuView {
+                aim_lock: true,
+                ..default()
+            },
+        };
+    }
+    if p.frame == 60 {
+        assert_eq!(roots.iter().count(), if p.stage == 3 { 0 } else { 1 });
+        let name = ["root", "aim", "feedback", "closed"][p.stage];
+        let path = format!("{}/{name}.png", p.directory);
+        p.waiting = true;
+        commands
+            .spawn(Screenshot::primary_window())
+            .observe(save_to_disk(path))
+            .observe(|_: On<ScreenshotCaptured>, mut p: ResMut<Preview>| {
+                p.stage += 1;
+                p.frame = 0;
+                p.waiting = false;
+            });
+    }
+}
