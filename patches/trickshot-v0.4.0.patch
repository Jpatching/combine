diff --git a/crates/console/src/practice.rs b/crates/console/src/practice.rs
new file mode 100644
index 0000000..9dea3de
--- /dev/null
+++ b/crates/console/src/practice.rs
@@ -0,0 +1,454 @@
+//! Local practice UI. Commands reuse the existing authority queues; no executable injection.
+use crate::ConsoleState;
+use crate::practice_core::{self, Spot};
+use crate::practice_menu::{Action, Controls, Menu};
+use crate::practice_ui::MenuView;
+use bevy::input::gamepad::GamepadButton as B;
+use bevy::input::keyboard::KeyboardInput;
+use bevy::prelude::*;
+use bots::{BotAddQueue, BotHold, BotRoster, BotTpQueue, BotTpRequest, BotTpTarget, BotTpWhere};
+use frame::{AppScreen, ClientSet, RuntimeRole, WorldGeneration};
+use net::{
+    ActionRequestIds, AuthorityWorld, ClientActionInbox, LocalPresentClient, PresentedSnapshot,
+};
+
+#[derive(Resource, Default)]
+pub(crate) struct Practice {
+    menu: Menu,
+    pub captured: bool,
+    available: bool,
+    generation: Option<u64>,
+    saved: Option<Spot>,
+    pending_return: Option<(Spot, f32)>,
+    aim_lock: bool,
+    locked_bot: Option<u32>,
+    old_aim: Option<AimSettings>,
+    status: String,
+}
+#[derive(Clone, Copy)]
+struct AimSettings {
+    preset: u8,
+    sensitivity: f32,
+    ads: f32,
+    curve: u8,
+    acceleration: bool,
+    deadzone: f32,
+}
+impl AimSettings {
+    fn read(s: &frame::GameSettings) -> Self {
+        Self {
+            preset: s.pad_sensitivity_preset,
+            sensitivity: s.pad_custom_sensitivity,
+            ads: s.pad_ads_sensitivity,
+            curve: s.pad_curve,
+            acceleration: s.pad_acceleration,
+            deadzone: s.pad_deadzone_right,
+        }
+    }
+    fn apply(self, s: &mut frame::GameSettings) {
+        s.pad_sensitivity_preset = self.preset;
+        s.pad_custom_sensitivity = self.sensitivity;
+        s.pad_ads_sensitivity = self.ads;
+        s.pad_curve = self.curve;
+        s.pad_acceleration = self.acceleration;
+        s.pad_deadzone_right = self.deadzone;
+        s.revision = s.revision.wrapping_add(1);
+    }
+}
+
+pub(crate) fn install(app: &mut App) {
+    app.init_resource::<Practice>()
+        .init_resource::<MenuView>()
+        .add_systems(
+            Update,
+            (publish_view, crate::practice_ui::render)
+                .chain()
+                .in_set(ClientSet::Ui),
+        )
+        .add_systems(
+            Update,
+            aim_lock
+                .after(net::sample_client_input)
+                .in_set(ClientSet::Input),
+        );
+}
+
+fn allowed(
+    role: Option<&RuntimeRole>,
+    world: Option<&AuthorityWorld>,
+    snapshot: &PresentedSnapshot,
+    local: &LocalPresentClient,
+    bots: &BotRoster,
+) -> bool {
+    let Some(s) = snapshot.snapshot() else {
+        return false;
+    };
+    practice_core::permitted(
+        role == Some(&RuntimeRole::Listen),
+        world.is_some_and(|w| w.0.cheats_enabled()),
+        true,
+        s.meta
+            .clients
+            .iter()
+            .any(|(id, _)| *id != local.0 && !bots.is_bot(*id)),
+    )
+}
+
+/// Runs before both gamepad menu navigation and gameplay publication.
+pub(crate) fn input(
+    mut state: ResMut<Practice>,
+    keyboard: (
+        MessageReader<KeyboardInput>,
+        Local<ButtonInput<KeyCode>>,
+        Res<ButtonInput<MouseButton>>,
+    ),
+    pads: Query<&Gamepad>,
+    active: Res<frame::ActivePad>,
+    devices: Res<frame::InputDevices>,
+    console: Res<ConsoleState>,
+    menus: Option<Res<hud::ScriptMenus>>,
+    minecraft: Option<Res<frame::MinecraftUi>>,
+    screen: Res<AppScreen>,
+    context: (
+        Option<Res<RuntimeRole>>,
+        Option<Res<AuthorityWorld>>,
+        Res<WorldGeneration>,
+        Res<PresentedSnapshot>,
+        Res<LocalPresentClient>,
+    ),
+    bots: (
+        Res<BotRoster>,
+        ResMut<BotAddQueue>,
+        ResMut<BotHold>,
+        ResMut<BotTpQueue>,
+    ),
+    mut skate: ResMut<frame::SkateMode>,
+    mut settings: ResMut<frame::GameSettings>,
+    actions: (
+        Option<ResMut<ClientActionInbox>>,
+        ResMut<ActionRequestIds>,
+        ResMut<net::LookState>,
+    ),
+    time: Res<Time>,
+) {
+    let (role, world, generation, snapshot, local) = context;
+    let (roster, mut add, mut hold, mut tp) = bots;
+    let (mut inbox, mut requests, mut look) = actions;
+    // Keep physical state independently: gameplay isolation resets ButtonInput.
+    let (mut events, mut keys, mouse) = keyboard;
+    keys.clear();
+    for event in events.read() {
+        if event.state.is_pressed() {
+            keys.press(event.key_code);
+        } else {
+            keys.release(event.key_code);
+        }
+    }
+    if !devices.focused {
+        keys.reset_all();
+    }
+    let pad = active.0.and_then(|e| pads.get(e).ok());
+    let held = |b| pad.is_some_and(|p| p.pressed(b));
+    let pressed = |b| pad.is_some_and(|p| p.just_pressed(b));
+    let controls = Controls {
+        up: keys.pressed(KeyCode::ArrowUp) || held(B::DPadUp) || held(B::LeftTrigger2),
+        down: keys.pressed(KeyCode::ArrowDown) || held(B::DPadDown) || held(B::RightTrigger2),
+        select: keys.pressed(KeyCode::Enter)
+            || keys.pressed(KeyCode::NumpadEnter)
+            || keys.pressed(KeyCode::ArrowRight)
+            || held(B::South)
+            || held(B::West)
+            || held(B::DPadRight),
+        back: keys.pressed(KeyCode::Backspace)
+            || keys.pressed(KeyCode::ArrowLeft)
+            || held(B::East)
+            || held(B::RightThumb)
+            || held(B::DPadLeft),
+        toggle: keys.just_pressed(KeyCode::F6) || (held(B::LeftTrigger2) && pressed(B::RightThumb)),
+        escape: keys.pressed(KeyCode::Escape),
+        any_down: keys.get_pressed().next().is_some()
+            || mouse.get_pressed().next().is_some()
+            || pad.is_some_and(|p| {
+                p.get_pressed().next().is_some()
+                    || p.get(B::LeftTrigger2).unwrap_or(0.) > 0.1
+                    || p.get(B::RightTrigger2).unwrap_or(0.) > 0.1
+            }),
+    };
+    if state.generation != generation.0 {
+        state.generation = generation.0;
+        state.saved = None;
+        state.pending_return = None;
+        state.aim_lock = false;
+        state.locked_bot = None;
+        state.menu.reset();
+        state.status = "New map: starting spot cleared; aim lock off.".into();
+    }
+    let usable = allowed(
+        role.as_deref(),
+        world.as_deref(),
+        &snapshot,
+        &local,
+        &roster,
+    );
+    state.available = usable && *screen == AppScreen::InGame;
+    let available = state.available
+        && devices.focused
+        && !console.open
+        && !menus.as_ref().is_some_and(|m| m.captures_input())
+        && !minecraft
+            .as_ref()
+            .is_some_and(|m| m.active && m.inventory_open)
+        && snapshot.alive_player(local.0).is_some();
+    let action = state
+        .menu
+        .step(controls, available, time.elapsed_secs_f64());
+    state.captured = state.menu.captured;
+    if !available {
+        state.pending_return = None;
+        state.locked_bot = None;
+        if !usable {
+            state.aim_lock = false;
+        }
+        return;
+    }
+    let Some(ps) = snapshot.alive_player(local.0) else {
+        return;
+    };
+    if let Some((spot, started)) = state.pending_return {
+        if !spot.valid_for(generation.0) || time.elapsed_secs() - started > 2.0 {
+            state.pending_return = None;
+            state.status = "Return cancelled: map changed or skating did not stop.".into();
+        } else if !skate.active && !skate.entering {
+            state.pending_return = None;
+            if let Some(inbox) = inbox.as_deref_mut() {
+                let request_id = requests.allocate();
+                match inbox.push(
+                    local.0,
+                    sim::ClientAction::Move {
+                        request_id,
+                        origin: spot.origin,
+                        angles: spot.angles,
+                    },
+                ) {
+                    Ok(()) => {
+                        look.angles = net::look_angles_from_degrees(std::array::from_fn(|i| {
+                            spot.angles[i] - ps.delta_angles[i]
+                        }));
+                        state.status = "Return requested.".into();
+                    }
+                    Err(e) => state.status = format!("Cannot return: {e}"),
+                }
+            } else {
+                state.status = "Return unavailable: no local authority.".into();
+            }
+        }
+    }
+    let Some(action) = action else {
+        return;
+    };
+    match action {
+        Action::Save => {
+            state.status = "Cannot save: map or position unavailable.".into();
+            if let Some(generation) = generation.0 {
+                let s = Spot {
+                    generation,
+                    origin: ps.origin,
+                    angles: ps.viewangles,
+                };
+                if s.valid_for(Some(generation)) {
+                    state.saved = Some(s);
+                    state.status = "Starting spot saved for this map.".into();
+                }
+            }
+        }
+        Action::Return => {
+            if let Some(s) = state.saved.filter(|s| s.valid_for(generation.0)) {
+                if skate.active || skate.entering {
+                    skate.toggle_requested = true;
+                }
+                state.pending_return = Some((s, time.elapsed_secs()));
+                state.status = "Leaving skating and returning...".into();
+            } else {
+                state.status = "Save a starting spot first.".into();
+            }
+        }
+        Action::AddBot => {
+            if roster.bots.len() >= bots::MAX_HOST_BOTS as usize {
+                state.status = "Bot limit reached.".into();
+            } else {
+                add.push_dummy(1);
+                state.status = "Bot requested. Place it after spawning.".into();
+            }
+        }
+        Action::PlaceBot => {
+            if let Some(bot) = roster
+                .bots
+                .iter()
+                .rev()
+                .find(|b| snapshot.alive_player(b.id).is_some())
+            {
+                let mut origin = ps.origin;
+                origin[2] += 10.0;
+                tp.push(BotTpRequest {
+                    target: BotTpTarget::Id(bot.id),
+                    where_: BotTpWhere::Absolute {
+                        origin,
+                        yaw: Some(ps.viewangles[1] + 180.),
+                        pitch: Some(0.),
+                    },
+                });
+                state.status = format!("Bot {} placement requested.", bot.id.0);
+            } else {
+                state.status = "No living bot: add a target and wait for it to spawn.".into();
+            }
+        }
+        Action::FreezeBots => {
+            hold.0 = !hold.0;
+            state.status = if hold.0 {
+                "Bots frozen; firing stopped."
+            } else {
+                "Bots unfrozen."
+            }
+            .into();
+        }
+        Action::AimLock => {
+            state.aim_lock = !state.aim_lock;
+            state.locked_bot = None;
+            state.status = if state.aim_lock {
+                "Aim lock ON: hold aim on foot."
+            } else {
+                "Aim lock OFF."
+            }
+            .into();
+        }
+        Action::SmoothAim => {
+            if state.old_aim.is_none() {
+                state.old_aim = Some(AimSettings::read(&settings));
+            }
+            AimSettings {
+                preset: 0,
+                sensitivity: 1.,
+                ads: 0.75,
+                curve: 0,
+                acceleration: false,
+                deadzone: 0.05,
+            }
+            .apply(&mut settings);
+            state.status = "Smooth preset applied.".into();
+        }
+        Action::RestoreAim => {
+            if let Some(old) = state.old_aim.take() {
+                old.apply(&mut settings);
+                state.status = "Previous aim settings restored.".into();
+            } else {
+                state.status = "No preset to restore in this session.".into();
+            }
+        }
+    }
+}
+
+fn publish_view(
+    state: Res<Practice>,
+    hold: Res<BotHold>,
+    devices: Res<frame::InputDevices>,
+    mut view: ResMut<MenuView>,
+) {
+    view.set_if_neq(MenuView {
+        open: state.menu.open && state.available,
+        page: state.menu.page,
+        selected: state.menu.cursor.selected,
+        offset: state.menu.cursor.offset,
+        frozen: hold.0,
+        aim_lock: state.aim_lock,
+        pad: devices.pad_prompts,
+        status: state.status.clone(),
+    });
+}
+
+fn aim_lock(
+    mut state: ResMut<Practice>,
+    role: Option<Res<RuntimeRole>>,
+    world: Option<Res<AuthorityWorld>>,
+    roster: Res<BotRoster>,
+    snapshot: Res<PresentedSnapshot>,
+    local: Res<LocalPresentClient>,
+    skate: Res<frame::SkateMode>,
+    console: Res<ConsoleState>,
+    devices: Res<frame::InputDevices>,
+    screen: Res<AppScreen>,
+    mut template: ResMut<net::ClientCmdTemplate>,
+    mut look: ResMut<net::LookState>,
+) {
+    state.locked_bot = None;
+    if !state.aim_lock
+        || state.captured
+        || skate.active
+        || skate.entering
+        || console.open
+        || !devices.focused
+        || *screen != AppScreen::InGame
+        || !template.ready
+        || template.cmd.buttons & playerstate_iw4::buttons::ADS == 0
+        || !allowed(
+            role.as_deref(),
+            world.as_deref(),
+            &snapshot,
+            &local,
+            &roster,
+        )
+    {
+        return;
+    }
+    let (Some(world), Some(s), Some(ps)) = (
+        world.as_ref(),
+        snapshot.snapshot(),
+        snapshot.alive_player(local.0),
+    ) else {
+        return;
+    };
+    let eye = [
+        ps.origin[0],
+        ps.origin[1],
+        ps.origin[2] + ps.view_height_current,
+    ];
+    let view = std::array::from_fn(|i| {
+        template.cmd.angles[i] as f32 / input_iw4::ANGLE2SHORT + ps.delta_angles[i]
+    });
+    let mine = s.meta.for_client(local.0).map(|m| m.client_state_team);
+    let mut best: Option<(u32, [f32; 3], f32)> = None;
+    for bot in &roster.bots {
+        let Some(target) = snapshot.alive_player(bot.id) else {
+            continue;
+        };
+        if s.meta.kind.is_team() && s.meta.for_client(bot.id).map(|m| m.client_state_team) == mine {
+            continue;
+        }
+        let point = [
+            target.origin[0],
+            target.origin[1],
+            target.origin[2] + target.view_height_current * 0.75,
+        ];
+        let Some((angles, error)) = practice_core::target_angles(eye, point, view) else {
+            continue;
+        };
+        let hit = world
+            .0
+            .trace_world(eye, point, [0.; 3], [0.; 3], hud_iw4::OVERHEAD_TRACE_MASK);
+        if hit.startsolid != 0 || hit.fraction < 1.0 {
+            continue;
+        }
+        if best.is_none_or(|(_, _, e)| error < e) {
+            best = Some((bot.id.0, angles, error));
+        }
+    }
+    if let Some((id, angles, _)) = best {
+        let command_angles = std::array::from_fn(|i| angles[i] - ps.delta_angles[i]);
+        template.cmd.angles = net::look_angles_from_degrees(command_angles);
+        look.angles = template.cmd.angles;
+        state.locked_bot = Some(id);
+    }
+}
+
+#[cfg(test)]
+#[path = "practice_tests.rs"]
+mod tests;
